pipeline {
    agent any
    stages {
        stage('prerequisites') {
            steps {
                script {
                    // Check if docker is installed
                    def dockerPath = sh(script: 'command -v docker || true', returnStdout: true).trim()
                    if (!dockerPath) {
                        error 'Docker is not installed.'
                    } else {
                        echo "Docker is installed at: ${dockerPath}"
                    }

                    // Check if docker-compose is installed
                    def dockerComposePath = sh(script: 'command -v docker-compose || command -v docker-compose || true', returnStdout: true).trim()
                    if (!dockerComposePath) {
                        error 'Docker Compose is not installed.'
                    } else {
                        echo "Docker Compose is installed at: ${dockerComposePath}"
                    }

                    // Check if Docker service is running
                    def dockerServiceStatus = sh(script: 'systemctl is-active docker || true', returnStdout: true).trim()
                    if (dockerServiceStatus == 'active') {
                        echo 'Docker service is running.'
                    } else {
                        error 'Docker service is not running.'
                    }

                    // Check if Docker Compose services are up
                    def dockerComposeStatus = sh(script: 'docker-compose ps || true', returnStdout: true).trim()
                    if (dockerComposeStatus) {
                        echo "Docker Compose services status:\n${dockerComposeStatus}"
                    } else {
                        echo "No Docker Compose services running."
                    }

                    // Exit the pipeline after checks
                    error "Exiting after prerequisite checks."
                }
            }
        }
    }
}
