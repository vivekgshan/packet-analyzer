pipeline {
    agent any
    stages {
        stage('Prerequisites') {
            steps {
                script {
                    // Detect package manager: dpkg or rpm
                    def isDeb = sh(script: "command -v dpkg || true", returnStdout: true).trim()
                    def isRpm = sh(script: "command -v rpm || true", returnStdout: true).trim()

                    // Print detected package managers for debugging
                    echo "Detected package manager - dpkg: ${isDeb}, rpm: ${isRpm}"

                    // Add Jenkins user to docker group so it can run Docker commands without sudo
                    echo "Adding jenkins user to docker group..."
                    sh "sudo usermod -aG docker jenkins || true"

                    // If Debian-based system detected
                    if (isDeb) {
                        echo "Installing Docker and Docker Compose for Debian-based system..."

                        // Check if Docker binary exists
                        def dockerCheck = sh(script: "command -v docker || true", returnStdout: true).trim()

                        // If Docker not found, install it
                        if (!dockerCheck) {
                            sh '''
                                sudo apt update
                                sudo apt install -y apt-transport-https ca-certificates curl software-properties-common lsb-release gnupg
                                curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor --batch --yes -o /usr/share/keyrings/docker-archive-keyring.gpg
                                echo "deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
                                sudo apt update
                                sudo apt install -y docker-ce docker-ce-cli containerd.io
                                sudo systemctl enable docker
                                sudo systemctl start docker
                            '''
                        } else {
                            echo "Docker is installed at: ${dockerCheck}"
                        }

                        // Check if Docker Compose is installed
                        def dockerComposeCheck = sh(script: "command -v docker-compose || command -v docker compose || true", returnStdout: true).trim()

                        // If Docker Compose not found, download and install it
                        if (!dockerComposeCheck) {
                            sh '''
                                sudo curl -L "https://github.com/docker/compose/releases/download/v2.18.1/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
                                sudo chmod +x /usr/local/bin/docker-compose
                            '''
                        } else {
                            echo "Docker Compose is installed at: ${dockerComposeCheck}"
                        }

                    // Else if RPM-based system detected
                    } else if (isRpm) {
                        echo "Installing Docker and Docker Compose for RPM-based system..."

                        // Check if Docker is installed
                        def dockerCheck = sh(script: "command -v docker || true", returnStdout: true).trim()

                        // If Docker not found, set up Docker repository and install with yum
                        if (!dockerCheck) {
                            sh '''
                                sudo yum install -y yum-utils
                                sudo yum-config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo
                                sudo yum install -y docker-ce docker-ce-cli containerd.io
                                sudo systemctl enable docker
                                sudo systemctl start docker
                            '''
                        } else {
                            echo "Docker is installed at: ${dockerCheck}"
                        }

                        // Check if Docker Compose installed
                        def dockerComposeCheck = sh(script: "command -v docker-compose || command -v docker compose || true", returnStdout: true).trim()

                        // If not, download and install it
                        if (!dockerComposeCheck) {
                            sh '''
                                sudo curl -L "https://github.com/docker/compose/releases/download/v2.18.1/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
                                sudo chmod +x /usr/local/bin/docker-compose
                            '''
                        } else {
                            echo "Docker Compose is installed at: ${dockerComposeCheck}"
                        }

                    // If neither Debian nor RPM detected, fail the build
                    } else {
                        error "Unsupported Linux distribution: This script supports only Debian or RPM-based distros."
                    }

                    // Check if Docker service is running
                    def dockerServiceStatus = sh(script: "systemctl is-active docker || true", returnStdout: true).trim()
                    if (dockerServiceStatus == "active") {
                        echo "Docker service is running"
                    } else {
                        error "Docker service is not running."
                    }

                    // Test Docker socket access by listing running containers
                    def dockerPsCheck = sh(script: "docker ps || true", returnStdout: true).trim()
                    if (dockerPsCheck.contains('permission denied') || dockerPsCheck.isEmpty()) {
                        echo "Warning: Permission denied accessing Docker socket. Ensure Jenkins user is in docker group and Jenkins restarted."
                    } else {
                        echo "Docker socket access verified."
                    }

                    // Check status of Docker Compose services
                    def dockerComposeStatus = sh(script: "docker-compose ps || docker compose ps || true", returnStdout: true).trim()
                    if (dockerComposeStatus) {
                        echo "Docker Compose services status:\n${dockerComposeStatus}"
                    } else {
                        echo "No Docker Compose services running or no permission to access Docker socket."
                    }
                }
            }
        }
    }
}
